{
  "name": "shadowrocket-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "rules:fetch": "node tools/abp-rules.js fetch",
    "rules:analyze": "node tools/abp-rules.js analyze",
    "rules:build": "node tools/abp-rules.js build",
    "rules:test": "vitest run tests/abp-rules.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node tools/validate-module.js",
    "check": "npm run lint && npm test && npm run validate && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.0",
    "vitest": "^4.1.12"
  }
}
