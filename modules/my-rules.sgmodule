#!name=我的 App 优化规则
#!desc=知乎广告过滤、网易云领福利入口优化、B站视频直连及开发服务分流；新增直连和遥测规则待使用验证。

# ====================================
# Zhihu / 知乎
# ====================================

# ====================================
# Bilibili / B站
# ====================================

# ====================================
# Douban / 豆瓣
# ====================================

# ====================================
# JD / 京东
# ====================================

# ====================================
# NetEase Music / 网易云音乐
# ====================================

[URL Rewrite]
# Zhihu / 知乎：统一拒绝商业接口。
^https://api\.zhihu\.com/commercial_api/ - reject

[Rule]
# IPv6 Local Network / 本地网络地址
IP-CIDR6,fc00::/7,DIRECT,no-resolve
IP-CIDR6,fe80::/10,DIRECT,no-resolve
IP-CIDR6,::1/128,DIRECT,no-resolve

# iPhone / 共享地址空间直连实验
IP-CIDR,100.64.0.0/10,DIRECT,no-resolve

# Telemetry / 遥测：精确规则置于服务级代理规则之前。
DOMAIN,otel.gitkraken.com,REJECT
DOMAIN,telemetry.individual.githubcopilot.com,REJECT
DOMAIN,copilot-telemetry.githubusercontent.com,REJECT
DOMAIN,abp.telemetry.adblockplus.org,REJECT
DOMAIN,adblockplus.telemetry.eyeo.com,REJECT

# Analytics & Advertising / 统计与广告
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN,static.cloudflareinsights.com,REJECT
DOMAIN-SUFFIX,carbonads.net,REJECT

# Google Advertising / 广告拦截实验，优先于主配置 Google 代理规则。
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,doubleclick-cn.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googlesyndication-cn.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googleadservices-cn.com,REJECT
DOMAIN-SUFFIX,adtrafficquality.google,REJECT

# Mobile Analytics / 移动端追踪拦截实验
DOMAIN-SUFFIX,appsflyersdk.com,REJECT
DOMAIN,analytics.adjust.com,REJECT
DOMAIN,api2.amplitude.com,REJECT
DOMAIN,ads-api.twitter.com,REJECT
DOMAIN,analytics.twitter.com,REJECT

# AI / AI 服务：使用主配置已有的 PROXY 策略。
DOMAIN-SUFFIX,chatgpt.com,PROXY
DOMAIN-SUFFIX,githubcopilot.com,PROXY
DOMAIN-SUFFIX,grok.com,PROXY
DOMAIN-SUFFIX,jetbrains.ai,PROXY
DOMAIN-SUFFIX,jetbrains.cloud,PROXY

# Productivity & GitHub / 协作与开发服务
# Notion 遥测试行代理，观察连接频率是否下降。
DOMAIN,http-inputs-notion.splunkcloud.com,PROXY
DOMAIN-SUFFIX,notion.com,PROXY
DOMAIN-SUFFIX,notion-static.com,PROXY
DOMAIN-SUFFIX,figma.com,PROXY
DOMAIN-SUFFIX,githubassets.com,PROXY

# Microsoft & VS Code / 微软与编辑器：不扩展到通用云服务整域。
DOMAIN-SUFFIX,vscode-cdn.net,DIRECT
DOMAIN,default.exp-tas.com,DIRECT
DOMAIN,vscode-sync.trafficmanager.net,DIRECT
DOMAIN-SUFFIX,static.microsoft,DIRECT
DOMAIN,officeci-mauservice.azurewebsites.net,DIRECT
DOMAIN-SUFFIX,office.com,DIRECT
DOMAIN-SUFFIX,office.net,DIRECT
DOMAIN-SUFFIX,vsassets.io,DIRECT
DOMAIN,oneclient.sfx.ms,DIRECT
DOMAIN,g.live.com,DIRECT

# Adblock Plus / 规则订阅
DOMAIN,easylist-downloads.adblockplus.org,DIRECT

# Apple / 新增服务直连，需使用验证。
DOMAIN-SUFFIX,itunes.com,DIRECT
DOMAIN,ingest.apple-studies.com,DIRECT

# OCSP & NTP / 证书状态及时间同步直连实验
DOMAIN,ocsp.digicert.com,DIRECT
DOMAIN,cacerts.digicert.com,DIRECT
DOMAIN-SUFFIX,pool.ntp.org,DIRECT

# JetBrains / IDE 普通服务
DOMAIN-SUFFIX,jetbrains.com,DIRECT

# Umeng / 友盟：包括消息推送，先按域名直连。
DOMAIN-SUFFIX,umeng.com,DIRECT
DOMAIN-SUFFIX,umengcloud.com,DIRECT

# Bilibili / B站：bilivideo.com 主域及所有子域名直连。
DOMAIN-SUFFIX,bilivideo.com,DIRECT
DOMAIN-SUFFIX,bilivideo.cn,DIRECT

[Script]
# NetEase Music / 网易云音乐：删除领福利顶部入口，取消 freeListen 默认选中；二进制 EAPI 响应解密后重新加密。
netease-home = type=http-response,pattern=^https://interface3\.music\.163\.com/eapi/link/home/framework/(?:tab|top/tab)(?:\?|$),requires-body=1,binary-body-mode=1,max-size=1048576,script-path=https://raw.githubusercontent.com/MaoqingW/shadowrocket-toolkit/refs/heads/main/scripts/netease/home.js
# Zhihu / 知乎：从本仓库公开分支加载响应脚本。
zhihu-recommend = type=http-response,pattern=^https://api\.zhihu\.com/topstory/recommend(?:\?|$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/MaoqingW/shadowrocket-toolkit/refs/heads/main/scripts/zhihu/recommend.js
# Zhihu / 知乎：仅移除回答流中 type=ad 的完整条目，保留回答、相关问题及分页。
zhihu-next-render = type=http-response,pattern=^https://api\.zhihu\.com/next-render(?:\?|$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/MaoqingW/shadowrocket-toolkit/refs/heads/main/scripts/zhihu/next-render.js
# Zhihu / 知乎：清空问题回答 feeds 响应顶层 ad_info。
zhihu-question-feeds = type=http-response,pattern=^https://api\.zhihu\.com/questions/[^/?#]+/feeds(?:\?|$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/MaoqingW/shadowrocket-toolkit/refs/heads/main/scripts/zhihu/question-feeds.js

[MITM]
hostname = %APPEND% api.zhihu.com, interface3.music.163.com
