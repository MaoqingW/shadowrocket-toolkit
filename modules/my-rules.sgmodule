#!name=我的 App 优化规则
#!desc=知乎商业接口拦截与推荐流广告过滤；脚本通过公开 HTTPS 地址加载。

# ====================================
# Zhihu / 知乎
# ====================================

# ====================================
# Bilibili / B站
# ====================================

# ====================================
# Douban / 豆瓣
# ====================================

# ====================================
# JD / 京东
# ====================================

# ====================================
# NetEase Music / 网易云音乐
# ====================================

[URL Rewrite]
# Zhihu / 知乎：统一拒绝商业接口。
^https://api\.zhihu\.com/commercial_api/ - reject

[Script]
# Zhihu / 知乎：从本仓库公开分支加载响应脚本。
zhihu-recommend = type=http-response,pattern=^https://api\.zhihu\.com/topstory/recommend(?:\?|$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/MaoqingW/shadowrocket-toolkit/refs/heads/codex/easylist-abp-converter/scripts/zhihu/recommend.js

[MITM]
hostname = %APPEND% api.zhihu.com
